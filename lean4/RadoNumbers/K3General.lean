/-! ### Round 117δ (R417δ, 2026-05-21) — Extended cardinality helpers.

  Continues R416δ with card-3, card-4, and card-5-complement
  extraction lemmas.  Uses Mathlib's `List.length_eq_three` and
  `List.length_eq_four`. -/

/-- **R417δ Helper card-3 extract**: $\mathrm{layerCount} = 3$
    extracts three distinct positions. -/
theorem layer3_card3_extract
    (χ : ℕ → ℕ) {c : ℕ} (hCard : layerCount χ c = 3) :
    ∃ p q r, p ∈ layer3 ∧ q ∈ layer3 ∧ r ∈ layer3 ∧
             p ≠ q ∧ p ≠ r ∧ q ≠ r ∧
             χ p = c ∧ χ q = c ∧ χ r = c ∧
             (∀ m, m ∈ layer3 → m ≠ p → m ≠ q → m ≠ r → χ m ≠ c) := by
  unfold layerCount at hCard
  obtain ⟨p, q, r, hTriple⟩ := List.length_eq_three.mp hCard
  have hp_in_filt : p ∈ layer3.filter (fun m => χ m = c) := by
    rw [hTriple]; simp
  have hq_in_filt : q ∈ layer3.filter (fun m => χ m = c) := by
    rw [hTriple]; simp
  have hr_in_filt : r ∈ layer3.filter (fun m => χ m = c) := by
    rw [hTriple]; simp
  have hL_nodup : layer3.Nodup := layer3_nodup
  have hFilt_nodup : (layer3.filter (fun m => χ m = c)).Nodup :=
    hL_nodup.filter _
  rw [hTriple] at hFilt_nodup
  rw [List.nodup_cons] at hFilt_nodup
  obtain ⟨hp_notin, hFilt_nodup⟩ := hFilt_nodup
  rw [List.nodup_cons] at hFilt_nodup
  obtain ⟨hq_notin, _⟩ := hFilt_nodup
  -- hp_notin : p ∉ [q, r]
  -- hq_notin : q ∉ [r]
  have hpq : p ≠ q := fun h => hp_notin (by rw [h]; exact List.mem_cons_self)
  have hpr : p ≠ r := fun h => hp_notin (by
    rw [h]; exact List.mem_cons.mpr (Or.inr (List.mem_singleton.mpr rfl)))
  have hqr : q ≠ r := fun h => hq_notin (by
    rw [h]; exact List.mem_singleton.mpr rfl)
  refine ⟨p, q, r, ?_, ?_, ?_, hpq, hpr, hqr, ?_, ?_, ?_, ?_⟩
  · exact List.mem_of_mem_filter hp_in_filt
  · exact List.mem_of_mem_filter hq_in_filt
  · exact List.mem_of_mem_filter hr_in_filt
  · have := (List.mem_filter.mp hp_in_filt).2; simpa using this
  · have := (List.mem_filter.mp hq_in_filt).2; simpa using this
  · have := (List.mem_filter.mp hr_in_filt).2; simpa using this
  · intro m hm hmp hmq hmr
    by_contra hne
    have hm_in : m ∈ layer3.filter (fun m => χ m = c) := by
      rw [List.mem_filter]; exact ⟨hm, by simpa using hne⟩
    rw [hTriple] at hm_in
    rcases List.mem_cons.mp hm_in with rfl | hm2
    · exact hmp rfl
    · rcases List.mem_cons.mp hm2 with rfl | hm3
      · exact hmq rfl
      · rw [List.mem_singleton] at hm3
        exact hmr hm3

/-- **R417δ Helper card-4 extract**: $\mathrm{layerCount} = 4$
