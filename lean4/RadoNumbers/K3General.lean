/-! ### Round 121 (R421, 2026-05-21) — `layer3_card3_two_known_force_third`
    completion helper.

  R420 introduced `layer3_card3_classify` (the "negative" direction:
  3 known c-positions ⇒ all other layer points are not c).  R421
  adds the complementary "positive" direction:

  `layer3_card3_two_known_force_third`: given 2 known c-positions
  $a, b$ and a third candidate $x$ such that NO OTHER layer point can
  be $c$, conclude $\chi(x) = c$.

  Proof strategy:
  * `layer3_card3_extract` gives 3 distinct c-positions $p, q, r$.
  * Each of $p, q, r$ must be in $\{a, b, x\}$, else `hOnly` would
    force $\chi(?) \ne c$.
  * Three distinct values from a 3-element set: one must equal $x$.
  * That position's $\chi$-value $= c$ transfers to $x$.

  Cost in 5+3+1 Target 3: 3 occurrences × ~25 lines each saved ⇒
  ~75 lines below the 300-line budget. -/

/-- **R421 helper**: 2 known c-positions plus singleton candidate
    closure ⇒ the candidate has color $c$.

    Complementary to `layer3_card3_classify`: instead of using
    cardinality to rule out a 4th c-position, this lemma uses
    cardinality (= 3) plus "only one remaining slot" to force a 3rd
    c-position. -/
theorem layer3_card3_two_known_force_third
    (χ : ℕ → ℕ) {c : ℕ}
    (hCard : layerCount χ c = 3)
    {a b x : ℕ}
    (haL : a ∈ layer3) (hbL : b ∈ layer3) (hxL : x ∈ layer3)
    (hab : a ≠ b) (hax : a ≠ x) (hbx : b ≠ x)
    (ha : χ a = c) (hb : χ b = c)
    (hOnly : ∀ m, m ∈ layer3 → m ≠ a → m ≠ b → m ≠ x → χ m ≠ c) :
    χ x = c := by
  obtain ⟨p, q, r, hpL, hqL, hrL, hpq, hpr, hqr, hp, hq, hr, _⟩ :=
    layer3_card3_extract χ hCard
  -- Each of p, q, r must lie in {a, b, x}, else `hOnly` contradicts.
  have hp_in_abx : p = a ∨ p = b ∨ p = x := by
    by_contra hne
    exact hOnly p hpL
      (fun h => hne (Or.inl h))
      (fun h => hne (Or.inr (Or.inl h)))
      (fun h => hne (Or.inr (Or.inr h))) hp
  have hq_in_abx : q = a ∨ q = b ∨ q = x := by
    by_contra hne
    exact hOnly q hqL
      (fun h => hne (Or.inl h))
      (fun h => hne (Or.inr (Or.inl h)))
      (fun h => hne (Or.inr (Or.inr h))) hq
  have hr_in_abx : r = a ∨ r = b ∨ r = x := by
    by_contra hne
    exact hOnly r hrL
      (fun h => hne (Or.inl h))
      (fun h => hne (Or.inr (Or.inl h)))
      (fun h => hne (Or.inr (Or.inr h))) hr
  clear hpL hqL hrL haL hbL hxL hCard
  -- 27-case rcases.  3 valid permutations (one of p, q, r = x) close
  -- by transferring χ ? = c to χ x = c.  Remaining 24 cases collapse
  -- via duplicate-position contradictions.
  rcases hp_in_abx with rfl | rfl | rfl
  · -- p = a
    rcases hq_in_abx with rfl | rfl | rfl
    · exact absurd rfl hpq                       -- q = a = p
    · -- q = b
      rcases hr_in_abx with rfl | rfl | rfl
      · exact absurd rfl hpr                     -- r = a = p
      · exact absurd rfl hqr                     -- r = b = q
      · exact hr                                 -- r = x ✓
    · exact hq                                   -- q = x ✓
  · -- p = b
    rcases hq_in_abx with rfl | rfl | rfl
    · -- q = a
      rcases hr_in_abx with rfl | rfl | rfl
      · exact absurd rfl hqr                     -- r = a = q
      · exact absurd rfl hpr                     -- r = b = p
      · exact hr                                 -- r = x ✓
    · exact absurd rfl hpq                       -- q = b = p
    · exact hq                                   -- q = x ✓
  · exact hp                                     -- p = x ✓

