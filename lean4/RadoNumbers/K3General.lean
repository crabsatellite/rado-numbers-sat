/-- **R435 — 4+3+2 cardinality master**: layer-3 partition with
    $|c_0| = 4$, $|c_1| = 3$, $|c_2| = 2$ is infeasible.

    Dispatches via χ(18) trichotomy into 3 chi18-branch helpers. -/
theorem compression_3_3_4_3_2_card_distribution_infeasible
    (χ : ℕ → ℕ)
    (hValid : IsValidColoring 27 3 χ)
    (hAvoid : AvoidsMonoSolution 3 27 χ)
    {c0 c1 c2 : ℕ}
    (hc01 : c0 ≠ c1) (hc02 : c0 ≠ c2) (hc12 : c1 ≠ c2)
    (hCard0 : layerCount χ c0 = 4)
    (hCard1 : layerCount χ c1 = 3)
    (hCard2 : layerCount χ c2 = 2) :
    False := by
  have L18 : (18 : ℕ) ∈ layer3 := by decide
  have h18_lt : χ 18 < 3 := layer3_chi_lt_3 χ hValid L18
  have _c0_lt : c0 < 3 := layer3_color_lt_3_of_card_pos χ hValid (by omega)
  have _c1_lt : c1 < 3 := layer3_color_lt_3_of_card_pos χ hValid (by omega)
  have _c2_lt : c2 < 3 := layer3_color_lt_3_of_card_pos χ hValid (by omega)
  have h18_in_3 : χ 18 = c0 ∨ χ 18 = c1 ∨ χ 18 = c2 := by
    by_contra hne
    have hne0 : χ 18 ≠ c0 := fun h => hne (Or.inl h)
    have hne1 : χ 18 ≠ c1 := fun h => hne (Or.inr (Or.inl h))
    have hne2 : χ 18 ≠ c2 := fun h => hne (Or.inr (Or.inr h))
    omega
  rcases h18_in_3 with h18 | h18 | h18
  · exact compression_3_3_4_3_2_chi18_eq_c0_pattern_dispatch χ hValid hAvoid
      hc01 hc02 hc12 hCard0 hCard1 hCard2 h18
  · exact compression_3_3_4_3_2_chi18_eq_c1_pattern_dispatch χ hValid hAvoid
      hc01 hc02 hc12 hCard0 hCard1 hCard2 h18
  · exact compression_3_3_4_3_2_chi18_eq_c2_pattern_dispatch χ hValid hAvoid
      hc01 hc02 hc12 hCard0 hCard1 hCard2 h18
