     = 2$ — contradicts mono-freeness. -/

/--
  **Round 66 Theorem (corner case $A_1 = \{3, 6\}$).**

  Closes the corner sub-case of 5+2+1 distribution where the
  2-block contains both 3 and 6.  Chain of forced colorings
  culminates in mono triple $(3, 7, 8)$.
-/
theorem compression_3_3_corner_A1_3_6_infeasible {n : ℕ} (hn : 26 ≤ n)
    (χ : ℕ → ℕ) (hValid : IsValidColoring n 3 χ)
    (hAvoid : AvoidsMonoSolution 3 n χ)
    (hχ6 : χ 6 = 0) (hχ12 : χ 12 = 0) (_hχ15 : χ 15 = 0)
    (_hχ21 : χ 21 = 0) (hχ24 : χ 24 = 0)
    (hχ3 : χ 3 = 2) (hχ9 : χ 9 = 1) (hχ18 : χ 18 = 1) :
    False := by
  -- Helper: mono triple via hAvoid.
  have mono_3 : ∀ (x y z : ℕ), 0 < x → 0 < y → 0 < z →
      x ≤ n → y ≤ n → z ≤ n →
      x + 3 * y = 3 * z → χ x = χ y → χ y = χ z → False :=
    fun x y z hx hy hz hxn hyn hzn heq hxy hyz =>
      hAvoid ⟨x, y, z, hxn, hyn, hzn, ⟨hx, hy, hz, heq⟩, hxy, hyz⟩
  -- χ(2) ≠ 2: triple (3, 2, 3). 3 + 3·2 = 9 = 3·3.
  have h_chi_2_ne_2 : χ 2 ≠ 2 := fun h =>
    mono_3 3 2 3 (by norm_num) (by norm_num) (by norm_num)
      (by omega) (by omega) (by omega) (by norm_num)
      (by rw [hχ3, h]) (by rw [h, hχ3])
  -- χ(2) ≠ 0: pair (2, 6) dist 4, multiple 3·4 = 12.
  have h_chi_2_ne_0 : χ 2 ≠ 0 := fun h =>
    color_avoids_distance_of_multiple (by omega : 2 ≤ 3) χ hAvoid
      (by omega : (0:ℕ) < 4) (by omega : (3:ℕ) * 4 ≤ n)
      2 (by norm_num) (by omega)
      (by show χ (3 * 4) = χ 2; rw [show (3:ℕ)*4 = 12 from by norm_num, hχ12, h])
      (by show χ 2 = χ (2 + 4); rw [show (2:ℕ)+4 = 6 from by norm_num, h, hχ6])
  have h_v2 : χ 2 < 3 := hValid 2 (by norm_num) (by omega)
  have h_chi_2 : χ 2 = 1 := by omega
  -- χ(4) ≠ 2: triple (3, 3, 4). 3 + 9 = 12 = 3·4.
  have h_chi_4_ne_2 : χ 4 ≠ 2 := fun h =>
    mono_3 3 3 4 (by norm_num) (by norm_num) (by norm_num)
      (by omega) (by omega) (by omega) (by norm_num)
      rfl (hχ3.trans h.symm)
