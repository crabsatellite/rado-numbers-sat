  proof in ~250 lines (was 450+ without). -/

/-- **R426 helper**: 2 named layer-3 positions with color $c$ classify
    the c-class.  Every other layer point has $\chi \ne c$.  Analog of
    R420 `layer3_card3_classify` for cardinality 2. -/
theorem layer3_card2_classify
    (χ : ℕ → ℕ) {c : ℕ}
    (hCard : layerCount χ c = 2)
    {p q : ℕ}
    (hpL : p ∈ layer3) (hqL : q ∈ layer3) (hpq : p ≠ q)
    (hp : χ p = c) (hq : χ q = c) :
    ∀ m, m ∈ layer3 → m ≠ p → m ≠ q → χ m ≠ c := by
  intro m hmL hmp hmq hmc
  obtain ⟨p', q', _, _, hp'q', hp'_eq, hq'_eq, hOther⟩ :=
    layer3_card2_extract χ hCard
  have hp_in : p = p' ∨ p = q' := by
    by_contra hne
    exact hOther p hpL (fun h => hne (Or.inl h)) (fun h => hne (Or.inr h)) hp
  have hq_in : q = p' ∨ q = q' := by
    by_contra hne
    exact hOther q hqL (fun h => hne (Or.inl h)) (fun h => hne (Or.inr h)) hq
  have hm_in : m = p' ∨ m = q' := by
    by_contra hne
    exact hOther m hmL (fun h => hne (Or.inl h)) (fun h => hne (Or.inr h)) hmc
  rcases hp_in with rfl | rfl <;> rcases hq_in with rfl | rfl <;>
    rcases hm_in with rfl | rfl <;>
    first
      | exact hpq rfl
      | exact hmp rfl
      | exact hmq rfl
      | exact hp'q' rfl
      | exact hp'q' (by rfl)

/-- **R420 helper**: 4 distinct layer points with color $c$ + card 3 → False. -/
private theorem layer3_card3_four_hits_impossible
    (χ : ℕ → ℕ) {c a b d m : ℕ}
    (hCard : layerCount χ c = 3)
    (haL : a ∈ layer3) (hbL : b ∈ layer3) (hdL : d ∈ layer3) (hmL : m ∈ layer3)
    (hab : a ≠ b) (had : a ≠ d) (ham : a ≠ m)
    (hbd : b ≠ d) (hbm : b ≠ m) (hdm : d ≠ m)
    (ha : χ a = c) (hb : χ b = c) (hd : χ d = c) (hm : χ m = c) :
    False := by
  have hNodup : (layer3.filter (fun x => χ x = c)).Nodup := layer3_nodup.filter _
  have hToFinsetCard : (layer3.filter (fun x => χ x = c)).toFinset.card = 3 := by
    rw [List.toFinset_card_of_nodup hNodup]; exact hCard
  have ha_in : a ∈ layer3.filter (fun x => χ x = c) :=
    List.mem_filter.mpr ⟨haL, by simpa using ha⟩
