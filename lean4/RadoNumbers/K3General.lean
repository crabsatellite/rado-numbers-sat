  | (4, 4, 1) |  315 |         283 |            28 |         4 |
  | (4, 3, 2) | 1260 |        1043 |           161 |        56 |
  | (3, 3, 3) |  280 |         223 |            44 |        13 |

  The 16 non-trivial layer-internal Rado triples (with $x, y, z$
  distinct):
  $(9, 3, 6), (18, 3, 9), (27, 3, 12), (18, 6, 12), (27, 6, 15),
   (18, 9, 15), (27, 9, 18), (9, 12, 15), (27, 12, 21), (9, 15, 18),
   (18, 15, 21), (27, 15, 24), (9, 18, 21), (9, 21, 24), (18, 21, 27),
   (9, 24, 27)$.

  **6+2+1 has only 2 survivors**, both with the same size-6 majority
  $C_7 = \{3, 6, 12, 15, 21, 24\}$ and omission triple
  $\{9, 18, 27\}$:
  * Survivor A: size-2 class $\{9, 18\}$, size-1 class $\{27\}$.
  * Survivor B: size-2 class $\{9, 27\}$, size-1 class $\{18\}$.

  Both survivors require off-layer analysis (R411+).

  **R410 deliverable**: partial closure of 6+2+1 at the cardinality
  level — specifically, the χ(18) = majority case (which forces the
  majority class to violate the (6, 9) forbidden edge).  This
  eliminates the χ(18) = majority "branch" of any 6+2+1 dispatcher.

  **Argument**: If χ(18) = c and (filter (· = c) on layer).length = 6:
  * Forbidden edges $(12, 18), (18, 24), (18, 27)$ give χ(12), χ(24),
    χ(27) ≠ c (using χ(18) = c).
  * So the complementary filter (positions ≠ c on layer) has length
    $9 - 6 = 3$ AND contains $\{12, 24, 27\}$ (three distinct nats).
  * By cardinality (3-element list contains 3 distinct elements iff
    those are exactly its elements), the complementary filter equals
    a permutation of $[12, 24, 27]$.
  * Therefore $\chi(6), \chi(9) = c$ (since 6, 9 are not in the
    complement).
  * But $(6, 9)$ is a forbidden edge — $\chi(6) = \chi(9)$ forces a
    monochromatic Rado triple $(9, 6, 9)$, contradicting `hAvoid`.

  This argument is layer-internal (no off-layer chromatic analysis
  required). -/

/--
  **Round 112 Lemma (R410) — 6+2+1, $\chi(18) =$ majority case is
  infeasible.**

  Layer-internal closure for the sub-case where the size-6 majority
  color contains $\chi(18)$.  This is one of three "$\chi(?) =$
  majority" branches of any 6+2+1 dispatcher (the other two,
  $\chi(9) =$ majority and $\chi(27) =$ majority, each leave one
  survivor — see R411 audit).
-/
theorem compression_3_3_card6_chi18_eq_majority_infeasible
    (χ : ℕ → ℕ)
    (hAvoid : AvoidsMonoSolution 3 27 χ)
    {c : ℕ}
    (hCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
              (fun m => χ m = c)).length = 6)
    (h18 : χ 18 = c) :
    False := by
  -- Forbidden edges + χ(18) = c give χ(12), χ(24), χ(27) ≠ c.
  have e_12 : χ 12 ≠ c := fun h12 =>
    -- Triple (18, 12, 18): 18 + 3·12 = 54 = 3·18.
    hAvoid ⟨18, 12, 18, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      h18.trans h12.symm, h12.trans h18.symm⟩
  have e_24 : χ 24 ≠ c := fun h24 =>
    -- Triple (18, 18, 24): 18 + 3·18 = 72 = 3·24.
    hAvoid ⟨18, 18, 24, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      rfl, h18.trans h24.symm⟩
  have e_27 : χ 27 ≠ c := fun h27 =>
    -- Triple (27, 18, 27): 27 + 3·18 = 81 = 3·27.
    hAvoid ⟨27, 18, 27, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      h27.trans h18.symm, h18.trans h27.symm⟩
  -- Complement filter has length 9 - 6 = 3.
  have hSplit := List.length_eq_length_filter_add
                   (l := ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ))
                   (fun m => decide (χ m = c))
  rw [show ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).length = 9 from rfl,
      hCard] at hSplit
  have hComplLen : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))).length = 3 := by omega
  -- Complement is Nodup (filter preserves Nodup of layer).
  have hCompl_nodup : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                       (fun m => !decide (χ m = c))).Nodup := by
    have hL_nodup : ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).Nodup := by decide
    exact hL_nodup.filter _
  -- Helper: build the "m ∈ complement" facts for 12, 24, 27.
  have h12_in : 12 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                  (fun m => !decide (χ m = c)) := by
    rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [e_12]
  have h24_in : 24 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                  (fun m => !decide (χ m = c)) := by
    rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [e_24]
  have h27_in : 27 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                  (fun m => !decide (χ m = c)) := by
    rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [e_27]
  -- Derive χ(6) = c and χ(9) = c via cardinality contradiction: if 6 (resp. 9)
  -- were not c, then {6, 12, 24, 27} ⊂ complement which has length 3 — impossible.
  have hToFinsetCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                         (fun m => !decide (χ m = c))).toFinset.card = 3 := by
    rw [List.toFinset_card_of_nodup hCompl_nodup]; exact hComplLen
  have h6 : χ 6 = c := by
    by_contra h6_ne
    have h6_in : 6 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                   (fun m => !decide (χ m = c)) := by
      rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h6_ne]
    have hSubset : ({6, 12, 24, 27} : Finset ℕ) ⊆
        (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
          (fun m => !decide (χ m = c))).toFinset := by
      intro m hm
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm
      rcases hm with rfl | rfl | rfl | rfl
      · exact List.mem_toFinset.mpr h6_in
      · exact List.mem_toFinset.mpr h12_in
      · exact List.mem_toFinset.mpr h24_in
      · exact List.mem_toFinset.mpr h27_in
    have := Finset.card_le_card hSubset
    rw [show ({6, 12, 24, 27} : Finset ℕ).card = 4 from by decide,
        hToFinsetCard] at this
    omega
  have h9 : χ 9 = c := by
    by_contra h9_ne
    have h9_in : 9 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                   (fun m => !decide (χ m = c)) := by
      rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h9_ne]
    have hSubset : ({9, 12, 24, 27} : Finset ℕ) ⊆
        (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
          (fun m => !decide (χ m = c))).toFinset := by
      intro m hm
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm
      rcases hm with rfl | rfl | rfl | rfl
      · exact List.mem_toFinset.mpr h9_in
      · exact List.mem_toFinset.mpr h12_in
      · exact List.mem_toFinset.mpr h24_in
      · exact List.mem_toFinset.mpr h27_in
    have := Finset.card_le_card hSubset
    rw [show ({9, 12, 24, 27} : Finset ℕ).card = 4 from by decide,
        hToFinsetCard] at this
    omega
  -- Now χ(6) = χ(9) = c.  Triple (9, 6, 9) is monochromatic.
  exact hAvoid ⟨9, 6, 9, by norm_num, by norm_num, by norm_num,
    ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
    h9.trans h6.symm, h6.trans h9.symm⟩

/-! ### Round 113 (R411, 2026-05-20) — 6+2+1 cardinality closure: χ(9), χ(27) anchors.

  R410 closed the $\chi(18) = c$ anchor.  R411 closes the remaining
  two cardinality-level anchor cases:
  * **$\chi(9) = c$**: $(6, 9), (9, 12)$ edges force $\chi(6),
    \chi(12) \ne c$.  Complement length-$3$ leaves one more
    non-$c$ position.  Case-split on $\chi(15), \chi(18)$:
    - If both $= c$: triple $(9, 15, 18)$ mono.
    - Otherwise: force $\chi(21), \chi(24) = c$ by cardinality;
      triple $(9, 21, 24)$ mono.
  * **$\chi(27) = c$**: $(18, 27)$ edge forces $\chi(18) \ne c$.
    Nested case-split on $\chi(9), \chi(6), \chi(12), \chi(15)$:
    - $\chi(6) = \chi(9) = c$: edge $(6, 9)$ mono.
    - $\chi(9) = \chi(12) = c$: edge $(9, 12)$ mono.
    - $\chi(15) = c$ and $\chi(6) = c$: triple $(27, 6, 15)$ mono.
    - Various other branches force triples $(27, 15, 24)$ or
      $(27, 3, 12)$ via cardinality.

  Each anchor case is closed by layer-internal Rado triples
  alone — no off-layer analysis required.

  **Combined with R410**: any $7+1+1$ majority hitting one of
  $\{9, 18, 27\}$ is now infeasible.  The only remaining
  cardinality survivor structure for $6+2+1$ has all of
  $\{9, 18, 27\} \notin$ majority class — these are precisely the
  two R410-audit survivors (R411-c candidates: off-layer
  closure). -/

/-- **Round 113 helper (R411)** — Finset-cardinality contradiction
    from 4 distinct non-$c$ layer positions when complement Finset
    has card 3.  Used in R411's by_cases dispatches. -/
private lemma layer3_four_non_c_impossible
    (χ : ℕ → ℕ) {c : ℕ}
    (hToFinsetCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                       (fun m => !decide (χ m = c))).toFinset.card = 3)
    {a b d e : ℕ}
    (ha_in : a ∈ (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))))
    (hb_in : b ∈ (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))))
    (hd_in : d ∈ (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))))
    (he_in : e ∈ (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))))
    (hCard4 : ({a, b, d, e} : Finset ℕ).card = 4) :
    False := by
  have hSubset : ({a, b, d, e} : Finset ℕ) ⊆
      (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
        (fun m => !decide (χ m = c))).toFinset := by
    intro m hm
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm
    rcases hm with rfl | rfl | rfl | rfl
    · exact List.mem_toFinset.mpr ha_in
    · exact List.mem_toFinset.mpr hb_in
    · exact List.mem_toFinset.mpr hd_in
    · exact List.mem_toFinset.mpr he_in
  have := Finset.card_le_card hSubset
  rw [hCard4, hToFinsetCard] at this
  omega

/--
  **Round 113 Lemma (R411) — 6+2+1, $\chi(9) =$ majority case is
  infeasible.**

  Layer-internal closure for the sub-case where the size-6 majority
  color contains $\chi(9)$.  Uses forbidden edges $(6, 9), (9, 12)$
  plus Rado triples $(9, 15, 18)$ or $(9, 21, 24)$.
-/
theorem compression_3_3_card6_chi9_eq_majority_infeasible
    (χ : ℕ → ℕ)
    (hAvoid : AvoidsMonoSolution 3 27 χ)
    {c : ℕ}
    (hCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
              (fun m => χ m = c)).length = 6)
    (h9 : χ 9 = c) :
    False := by
  -- Forbidden edges from χ(9) = c.
  have e_6 : χ 6 ≠ c := fun h6 =>
    -- Triple (9, 6, 9): 9 + 18 = 27 = 3·9.
    hAvoid ⟨9, 6, 9, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      h9.trans h6.symm, h6.trans h9.symm⟩
  have e_12 : χ 12 ≠ c := fun h12 =>
    -- Triple (9, 9, 12): 9 + 27 = 36 = 3·12.
    hAvoid ⟨9, 9, 12, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      rfl, h9.trans h12.symm⟩
  -- Setup: complement length 3.
  have hSplit := List.length_eq_length_filter_add
                   (l := ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ))
                   (fun m => decide (χ m = c))
  rw [show ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).length = 9 from rfl,
      hCard] at hSplit
  have hComplLen : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))).length = 3 := by omega
  have hCompl_nodup : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                       (fun m => !decide (χ m = c))).Nodup := by
    have hL_nodup : ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).Nodup := by decide
    exact hL_nodup.filter _
  have hToFinsetCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                         (fun m => !decide (χ m = c))).toFinset.card = 3 := by
    rw [List.toFinset_card_of_nodup hCompl_nodup]; exact hComplLen
  -- {6, 12} ⊆ complement.
  have h6_in : 6 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                 (fun m => !decide (χ m = c)) := by
    rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [e_6]
  have h12_in : 12 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                  (fun m => !decide (χ m = c)) := by
    rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [e_12]
  -- Main case split: either (15, 18) both c (immediate triple) or one is non-c
  -- (forces 21, 24 = c via cardinality, giving (9, 21, 24) triple).
  by_cases h15 : χ 15 = c
  · by_cases h18 : χ 18 = c
    · -- Triple (9, 15, 18): 9 + 45 = 54 = 3·18.
      exact hAvoid ⟨9, 15, 18, by norm_num, by norm_num, by norm_num,
        ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
        h9.trans h15.symm, h15.trans h18.symm⟩
    · -- χ(18) ≠ c.  Force χ(21), χ(24) = c via 4-element complement contradiction.
      have h18_in : 18 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                      (fun m => !decide (χ m = c)) := by
        rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h18]
      have h21 : χ 21 = c := by
        by_contra h21_ne
        have h21_in : 21 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                       (fun m => !decide (χ m = c)) := by
          rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h21_ne]
        exact layer3_four_non_c_impossible χ hToFinsetCard h6_in h12_in h18_in h21_in
          (by decide : ({6, 12, 18, 21} : Finset ℕ).card = 4)
      have h24 : χ 24 = c := by
        by_contra h24_ne
        have h24_in : 24 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                       (fun m => !decide (χ m = c)) := by
          rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h24_ne]
        exact layer3_four_non_c_impossible χ hToFinsetCard h6_in h12_in h18_in h24_in
          (by decide : ({6, 12, 18, 24} : Finset ℕ).card = 4)
      -- Triple (9, 21, 24): 9 + 63 = 72 = 3·24.
      exact hAvoid ⟨9, 21, 24, by norm_num, by norm_num, by norm_num,
        ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
        h9.trans h21.symm, h21.trans h24.symm⟩
  · -- χ(15) ≠ c.  Force χ(21), χ(24) = c.
    have h15_in : 15 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c)) := by
      rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h15]
    have h21 : χ 21 = c := by
      by_contra h21_ne
      have h21_in : 21 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                     (fun m => !decide (χ m = c)) := by
        rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h21_ne]
      exact layer3_four_non_c_impossible χ hToFinsetCard h6_in h12_in h15_in h21_in
        (by decide : ({6, 12, 15, 21} : Finset ℕ).card = 4)
    have h24 : χ 24 = c := by
      by_contra h24_ne
      have h24_in : 24 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                     (fun m => !decide (χ m = c)) := by
        rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h24_ne]
      exact layer3_four_non_c_impossible χ hToFinsetCard h6_in h12_in h15_in h24_in
        (by decide : ({6, 12, 15, 24} : Finset ℕ).card = 4)
    -- Triple (9, 21, 24): 9 + 63 = 72 = 3·24.
    exact hAvoid ⟨9, 21, 24, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      h9.trans h21.symm, h21.trans h24.symm⟩

/--
  **Round 113 Lemma (R411) — 6+2+1, $\chi(27) =$ majority case is
  infeasible.**

  Layer-internal closure for the sub-case where the size-6 majority
  color contains $\chi(27)$.  Uses forbidden edges $(6, 9), (9, 12),
  (18, 27)$ plus Rado triples $(27, 6, 15), (27, 15, 24), (27, 3,
  12)$.
-/
theorem compression_3_3_card6_chi27_eq_majority_infeasible
    (χ : ℕ → ℕ)
    (hAvoid : AvoidsMonoSolution 3 27 χ)
    {c : ℕ}
    (hCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
              (fun m => χ m = c)).length = 6)
    (h27 : χ 27 = c) :
    False := by
  -- Forbidden edge (18, 27): χ(18) ≠ c.
  have e_18 : χ 18 ≠ c := fun h18 =>
    -- Triple (27, 18, 27): 27 + 54 = 81 = 3·27.
    hAvoid ⟨27, 18, 27, by norm_num, by norm_num, by norm_num,
      ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
      h27.trans h18.symm, h18.trans h27.symm⟩
  -- Setup: complement length 3.
  have hSplit := List.length_eq_length_filter_add
                   (l := ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ))
                   (fun m => decide (χ m = c))
  rw [show ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).length = 9 from rfl,
      hCard] at hSplit
  have hComplLen : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                    (fun m => !decide (χ m = c))).length = 3 := by omega
  have hCompl_nodup : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                       (fun m => !decide (χ m = c))).Nodup := by
    have hL_nodup : ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).Nodup := by decide
    exact hL_nodup.filter _
  have hToFinsetCard : (([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                         (fun m => !decide (χ m = c))).toFinset.card = 3 := by
    rw [List.toFinset_card_of_nodup hCompl_nodup]; exact hComplLen
  -- 18 ∈ complement.
  have h18_in : 18 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                  (fun m => !decide (χ m = c)) := by
    rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [e_18]
  -- Main case split: nested by_cases.
  by_cases h9 : χ 9 = c
  · by_cases h6 : χ 6 = c
    · -- Edge (6, 9) mono: triple (9, 6, 9).
      exact hAvoid ⟨9, 6, 9, by norm_num, by norm_num, by norm_num,
        ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
        h9.trans h6.symm, h6.trans h9.symm⟩
    · -- χ(6) ≠ c.
      have h6_in : 6 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                     (fun m => !decide (χ m = c)) := by
        rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h6]
      by_cases h12 : χ 12 = c
      · -- Edge (9, 12) mono: triple (9, 9, 12).
        exact hAvoid ⟨9, 9, 12, by norm_num, by norm_num, by norm_num,
          ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩,
          rfl, h9.trans h12.symm⟩
      · -- χ(12) ≠ c.  Complement ⊇ {6, 12, 18}, length 3 ⇒ those 3.
        -- Force χ(15), χ(24) = c via cardinality; triple (27, 15, 24).
        have h12_in : 12 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                        (fun m => !decide (χ m = c)) := by
          rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h12]
        have h15 : χ 15 = c := by
          by_contra h15_ne
          have h15_in : 15 ∈ ([3, 6, 9, 12, 15, 18, 21, 24, 27] : List ℕ).filter
                          (fun m => !decide (χ m = c)) := by
            rw [List.mem_filter]; refine ⟨by simp, ?_⟩; simp [h15_ne]
          exact layer3_four_non_c_impossible χ hToFinsetCard h6_in h12_in h15_in h18_in
            (by decide : ({6, 12, 15, 18} : Finset ℕ).card = 4)
