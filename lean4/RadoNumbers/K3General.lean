/-! ### Round 116δ (R416δ, 2026-05-21) — Layer cardinality helpers.

  Shared definitions and extraction lemmas for use by cardinality
  wrappers (R416α/β/γ + future work).  `layer3` and `layerCount`
  give a clean interface; `layer3_card1_extract` and
  `layer3_card2_extract` extract concrete position(s) from card
  hypotheses. -/

/-- The canonical 9-point layer of multiples of $3$ in
    $\{1, \ldots, 27\}$. -/
def layer3 : List ℕ := [3, 6, 9, 12, 15, 18, 21, 24, 27]

/-- Count of layer-$3$ points colored with value $c$. -/
def layerCount (χ : ℕ → ℕ) (c : ℕ) : ℕ :=
  (layer3.filter (fun m => χ m = c)).length

theorem layer3_length : layer3.length = 9 := rfl

theorem layer3_nodup : layer3.Nodup := by decide

/-- **R416δ Helper card-1 extract**: $\mathrm{layerCount} = 1$ pins
    the unique layer position with color $c$, and every other
    layer position has $\chi \ne c$. -/
theorem layer3_card1_extract
    (χ : ℕ → ℕ) {c : ℕ} (hCard : layerCount χ c = 1) :
    ∃ p, p ∈ layer3 ∧ χ p = c ∧
         (∀ m, m ∈ layer3 → m ≠ p → χ m ≠ c) := by
  unfold layerCount at hCard
  obtain ⟨p, hPair⟩ := List.length_eq_one_iff.mp hCard
  have hp_in_filt : p ∈ layer3.filter (fun m => χ m = c) := by
    rw [hPair]; simp
  refine ⟨p, ?_, ?_, ?_⟩
  · exact List.mem_of_mem_filter hp_in_filt
  · have := (List.mem_filter.mp hp_in_filt).2; simpa using this
  · intro m hm hmp
    by_contra hne
    have hm_in_filt : m ∈ layer3.filter (fun m => χ m = c) := by
      rw [List.mem_filter]; exact ⟨hm, by simpa using hne⟩
    rw [hPair] at hm_in_filt
    rw [List.mem_singleton] at hm_in_filt
    exact hmp hm_in_filt

/-- **R416δ Helper card-2 extract**: $\mathrm{layerCount} = 2$
    extracts two distinct layer positions with color $c$, and
    every other layer position has $\chi \ne c$. -/
theorem layer3_card2_extract
    (χ : ℕ → ℕ) {c : ℕ} (hCard : layerCount χ c = 2) :
    ∃ p q, p ∈ layer3 ∧ q ∈ layer3 ∧ p ≠ q ∧
           χ p = c ∧ χ q = c ∧
           (∀ m, m ∈ layer3 → m ≠ p → m ≠ q → χ m ≠ c) := by
  unfold layerCount at hCard
  obtain ⟨p, q, hPair⟩ := List.length_eq_two.mp hCard
  have hp_in_filt : p ∈ layer3.filter (fun m => χ m = c) := by
    rw [hPair]; simp
  have hq_in_filt : q ∈ layer3.filter (fun m => χ m = c) := by
    rw [hPair]; simp
  have hL_nodup : layer3.Nodup := layer3_nodup
  have hFilt_nodup : (layer3.filter (fun m => χ m = c)).Nodup :=
    hL_nodup.filter _
  refine ⟨p, q, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact List.mem_of_mem_filter hp_in_filt
  · exact List.mem_of_mem_filter hq_in_filt
  · rw [hPair] at hFilt_nodup
    rw [List.nodup_cons, List.mem_singleton] at hFilt_nodup
    exact hFilt_nodup.1
  · have := (List.mem_filter.mp hp_in_filt).2; simpa using this
  · have := (List.mem_filter.mp hq_in_filt).2; simpa using this
  · intro m hm hmp hmq
    by_contra hne
    have hm_in_filt : m ∈ layer3.filter (fun m => χ m = c) := by
      rw [List.mem_filter]; exact ⟨hm, by simpa using hne⟩
    rw [hPair] at hm_in_filt
    rcases List.mem_cons.mp hm_in_filt with rfl | hmem2
    · exact hmp rfl
    · rw [List.mem_singleton] at hmem2
      exact hmq hmem2

