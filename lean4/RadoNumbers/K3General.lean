  have hrs : r ≠ s := fun h => hr_notin (by
    rw [h]; exact List.mem_singleton.mpr rfl)
  refine ⟨p, q, r, s, ?_, ?_, ?_, ?_, hpq, hpr, hps, hqr, hqs, hrs, ?_, ?_, ?_, ?_, ?_⟩
  · exact List.mem_of_mem_filter hp_in
  · exact List.mem_of_mem_filter hq_in
  · exact List.mem_of_mem_filter hr_in
  · exact List.mem_of_mem_filter hs_in
  · have := (List.mem_filter.mp hp_in).2; simpa using this
  · have := (List.mem_filter.mp hq_in).2; simpa using this
  · have := (List.mem_filter.mp hr_in).2; simpa using this
  · have := (List.mem_filter.mp hs_in).2; simpa using this
  · intro m hm hmp hmq hmr hms
    by_contra hne
    have hm_in : m ∈ layer3.filter (fun m => χ m = c) := by
      rw [List.mem_filter]; exact ⟨hm, by simpa using hne⟩
    rw [hQuad] at hm_in
    rcases List.mem_cons.mp hm_in with rfl | hm2
    · exact hmp rfl
    · rcases List.mem_cons.mp hm2 with rfl | hm3
      · exact hmq rfl
      · rcases List.mem_cons.mp hm3 with rfl | hm4
        · exact hmr rfl
        · rw [List.mem_singleton] at hm4; exact hms hm4

/-- **R417δ Helper card-5 complement extract**: $\mathrm{layerCount}
    = 5$ extracts four OMITTED positions (those NOT colored $c$). -/
theorem layer3_card5_complement_extract
    (χ : ℕ → ℕ) {c : ℕ} (hCard : layerCount χ c = 5) :
    ∃ p q r s, p ∈ layer3 ∧ q ∈ layer3 ∧ r ∈ layer3 ∧ s ∈ layer3 ∧
               p ≠ q ∧ p ≠ r ∧ p ≠ s ∧ q ≠ r ∧ q ≠ s ∧ r ≠ s ∧
               χ p ≠ c ∧ χ q ≠ c ∧ χ r ≠ c ∧ χ s ≠ c ∧
               (∀ m, m ∈ layer3 → m ≠ p → m ≠ q → m ≠ r → m ≠ s → χ m = c) := by
  unfold layerCount at hCard
  have hSplit := List.length_eq_length_filter_add (l := layer3)
                   (fun m => decide (χ m = c))
  rw [show layer3.length = 9 from rfl, hCard] at hSplit
  have hComplLen : (layer3.filter (fun m => !decide (χ m = c))).length = 4 := by
    omega
  obtain ⟨p, q, r, s, hQuad⟩ := List.length_eq_four.mp hComplLen
  have hp_in : p ∈ layer3.filter (fun m => !decide (χ m = c)) := by rw [hQuad]; simp
  have hq_in : q ∈ layer3.filter (fun m => !decide (χ m = c)) := by rw [hQuad]; simp
  have hr_in : r ∈ layer3.filter (fun m => !decide (χ m = c)) := by rw [hQuad]; simp
  have hs_in : s ∈ layer3.filter (fun m => !decide (χ m = c)) := by rw [hQuad]; simp
  have hL_nodup : layer3.Nodup := layer3_nodup
  have hFilt_nodup : (layer3.filter (fun m => !decide (χ m = c))).Nodup :=
    hL_nodup.filter _
  rw [hQuad] at hFilt_nodup
  rw [List.nodup_cons] at hFilt_nodup
  obtain ⟨hp_notin, hFilt_nodup⟩ := hFilt_nodup
  rw [List.nodup_cons] at hFilt_nodup
  obtain ⟨hq_notin, hFilt_nodup⟩ := hFilt_nodup
  rw [List.nodup_cons] at hFilt_nodup
  obtain ⟨hr_notin, _⟩ := hFilt_nodup
  have hpq : p ≠ q := fun h => hp_notin (by rw [h]; exact List.mem_cons_self)
  have hpr : p ≠ r := fun h => hp_notin (by
    rw [h]; exact List.mem_cons.mpr (Or.inr (List.mem_cons.mpr (Or.inl rfl))))
  have hps : p ≠ s := fun h => hp_notin (by
    rw [h]; exact List.mem_cons.mpr (Or.inr (List.mem_cons.mpr
      (Or.inr (List.mem_singleton.mpr rfl)))))
  have hqr : q ≠ r := fun h => hq_notin (by rw [h]; exact List.mem_cons_self)
  have hqs : q ≠ s := fun h => hq_notin (by
    rw [h]; exact List.mem_cons.mpr (Or.inr (List.mem_singleton.mpr rfl)))
  have hrs : r ≠ s := fun h => hr_notin (by
    rw [h]; exact List.mem_singleton.mpr rfl)
  refine ⟨p, q, r, s, ?_, ?_, ?_, ?_, hpq, hpr, hps, hqr, hqs, hrs, ?_, ?_, ?_, ?_, ?_⟩
  · exact List.mem_of_mem_filter hp_in
  · exact List.mem_of_mem_filter hq_in
  · exact List.mem_of_mem_filter hr_in
  · exact List.mem_of_mem_filter hs_in
  · have := (List.mem_filter.mp hp_in).2; simpa using this
  · have := (List.mem_filter.mp hq_in).2; simpa using this
  · have := (List.mem_filter.mp hr_in).2; simpa using this
  · have := (List.mem_filter.mp hs_in).2; simpa using this
  · intro m hm hmp hmq hmr hms
    by_contra hne
    -- m ∈ layer3, χ m ≠ c, so m in complement filter, hence in [p, q, r, s] — but
    -- m ≠ any of them.  But wait, we want χ m = c.  So assume χ m ≠ c.
    -- Actually we want to prove χ m = c.  by_contra gives χ m ≠ c.
    have hm_in : m ∈ layer3.filter (fun m => !decide (χ m = c)) := by
      rw [List.mem_filter]; exact ⟨hm, by simpa using hne⟩
    rw [hQuad] at hm_in
    rcases List.mem_cons.mp hm_in with rfl | hm2
    · exact hmp rfl
    · rcases List.mem_cons.mp hm2 with rfl | hm3
      · exact hmq rfl
      · rcases List.mem_cons.mp hm3 with rfl | hm4
        · exact hmr rfl
        · rw [List.mem_singleton] at hm4; exact hms hm4

/-! ### Round 118α (R418α, 2026-05-21) — generic helper for "χ(18) = c
    and layerCount = 5 ⇒ False".

  Used by the 5+3+1 master to close the χ(18) = c0 (size-5 majority)
  sub-case for ANY non-18 singleton.

  Forbidden edges (12, 18), (18, 24), (18, 27) force 12, 24, 27 ∉ c.
  With layerCount = 5 and 18 ∈ c-class, c-class = {18} ∪ (4 of
  {3, 6, 9, 15, 21}).  Each of 5 such configurations contains a
  mono Rado triple. -/

set_option maxHeartbeats 1000000 in
/-- **R418α helper** — χ(18) = c with layerCount = 5 forces mono. -/
theorem layer3_card5_chi18_eq_color_infeasible
    (χ : ℕ → ℕ)
    (hValid : IsValidColoring 27 3 χ)
    (hAvoid : AvoidsMonoSolution 3 27 χ)
    {c : ℕ}
    (h18 : χ 18 = c)
    (hCard : layerCount χ c = 5) :
    False := by
  have mono_3 : ∀ (x y z : ℕ), 0 < x → 0 < y → 0 < z →
      x ≤ 27 → y ≤ 27 → z ≤ 27 →
      x + 3 * y = 3 * z → χ x = χ y → χ y = χ z → False :=
    fun x y z hx hy hz hxn hyn hzn heq hxy hyz =>
      hAvoid ⟨x, y, z, hxn, hyn, hzn, ⟨hx, hy, hz, heq⟩, hxy, hyz⟩
  have e_12 : χ 12 ≠ c := fun h12 =>
    mono_3 18 12 18 (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (h18.trans h12.symm) (h12.trans h18.symm)
  have e_24 : χ 24 ≠ c := fun h24 =>
    mono_3 18 18 24 (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      rfl (h18.trans h24.symm)
  have e_27 : χ 27 ≠ c := fun h27 =>
    mono_3 27 18 27 (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (h27.trans h18.symm) (h18.trans h27.symm)
  -- by_cases on the 5 unknown layer positions ({3, 6, 9, 15, 21}).
  by_cases h3 : χ 3 = c <;> by_cases h6 : χ 6 = c <;>
  by_cases h9 : χ 9 = c <;> by_cases h15 : χ 15 = c <;>
  by_cases h21 : χ 21 = c <;>
  first
    | -- (9, 6, 9): mono if χ(6) = χ(9) = c
      exact mono_3 9 6 9 (by norm_num) (by norm_num) (by norm_num)
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (h9.trans h6.symm) (h6.trans h9.symm)
    | -- (18, 3, 9): mono if χ(3) = χ(9) = c (χ(18) = c given)
      exact mono_3 18 3 9 (by norm_num) (by norm_num) (by norm_num)
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (h18.trans h3.symm) (h3.trans h9.symm)
    | -- (18, 15, 21): mono if χ(15) = χ(21) = c (χ(18) = c given)
      exact mono_3 18 15 21 (by norm_num) (by norm_num) (by norm_num)
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (h18.trans h15.symm) (h15.trans h21.symm)
    | -- contradict hCard via layerCount unfolding
      (simp only [layerCount, show layer3 = [3, 6, 9, 12, 15, 18, 21, 24, 27]
                  from rfl,
                  List.filter_cons, List.filter_nil,
                  List.length_cons, List.length_nil,
                  decide_eq_true_iff, decide_eq_false_iff_not,
                  h3, h6, h9, h15, h21, h18, e_12, e_24, e_27,
                  ↓reduceIte, Nat.zero_add, Nat.add_zero] at hCard
       omega)

