  exact compression_3_3_AP_1_4_7_10_13_infeasible hn χ hValid hAvoid
    h_chi_1_ne h_chi_4_ne h_chi_7_ne h_chi_10_ne h_chi_13_ne
    hχ9_ne hχ18_ne hχ9_18_ne

