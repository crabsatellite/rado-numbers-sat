  have h_a3 : χ (a + 9) = χ 9 ∨ χ (a + 9) = χ 18 := by omega
  have h_a4 : χ (a + 12) = χ 9 ∨ χ (a + 12) = χ 18 := by omega
  exact AP5_avoidance_contradiction χ hAvoid (a := a) (c1 := χ 9) (c2 := χ 18)
