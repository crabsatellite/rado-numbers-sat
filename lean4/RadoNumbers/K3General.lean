/-! ### Round 74 (2026-05-15) — second corner case: $A_0 =
    \{1, 4, 5, 7, 8\}$, $A_1 = \{3, 6\}$ (i.e., $\chi(9) =
    \chi(18) = 1$), $A_2 = \{2\}$ (i.e., $\chi(6) = 2$).

  Round 66 handled the corner $A_2 = \{1\}$ ($\chi(3) = 2$); Round
  74 handles the corner $A_2 = \{2\}$ ($\chi(6) = 2$).  Different
  attack: distance pair on χ(6) = 2 gives "distance 2 forbidden in
  color 2".  This forces a chain $\chi(4) = 1, \chi(7) = 2,
  \chi(5) = 1$, after which $\chi(8)$ has no valid color. -/

/--
  **Round 74 Theorem (corner case $A_2 = \{2\}$).**

  Closes the corner sub-case of 5+2+1 where $\chi(9) = \chi(18) =
  1$ and the only color-2 multiple is $\chi(6) = 2$.

  Proof chain:
  1. $\chi(4) = 1$: triple $(3, 3, 4)$ rules out $\chi(4) = 0$;
     triple $(6, 4, 6)$ rules out $\chi(4) = 2$.
  2. $\chi(7) = 2$: distance pair $(7, 12)$ via mult 15 rules out
     $\chi(7) = 0$; triple $(9, 4, 7)$ rules out $\chi(7) = 1$.
  3. $\chi(5) = 1$: distance pair $(5, 12)$ via mult 21 rules out
     $\chi(5) = 0$; distance pair $(5, 7)$ via mult 6 rules out
     $\chi(5) = 2$.
  4. $\chi(8)$ contradicts: distance pair $(3, 8)$ via mult 15
     rules out 0; triple $(9, 5, 8)$ rules out 1; distance pair
     $(6, 8)$ via mult 6 rules out 2.  No valid color → False.
-/
theorem compression_3_3_corner_A2_at_6_infeasible {n : ℕ} (hn : 26 ≤ n)
    (χ : ℕ → ℕ) (hValid : IsValidColoring n 3 χ)
    (hAvoid : AvoidsMonoSolution 3 n χ)
    (hχ3 : χ 3 = 0) (hχ12 : χ 12 = 0) (hχ15 : χ 15 = 0)
    (hχ21 : χ 21 = 0) (_hχ24 : χ 24 = 0)
    (hχ6 : χ 6 = 2) (hχ9 : χ 9 = 1) (_hχ18 : χ 18 = 1) :
    False := by
  -- Helper for direct mono-triple derivation.
  have mono_3 : ∀ (x y z : ℕ), 0 < x → 0 < y → 0 < z →
      x ≤ n → y ≤ n → z ≤ n →
      x + 3 * y = 3 * z → χ x = χ y → χ y = χ z → False :=
    fun x y z hx hy hz hxn hyn hzn heq hxy hyz =>
      hAvoid ⟨x, y, z, hxn, hyn, hzn, ⟨hx, hy, hz, heq⟩, hxy, hyz⟩
  -- Step 1: χ(4) = 1.
  -- χ(4) ≠ 0: triple (3, 3, 4). 3 + 9 = 12 = 3·4.
  have h_chi_4_ne_0 : χ 4 ≠ 0 := fun h =>
    mono_3 3 3 4 (by norm_num) (by norm_num) (by norm_num)
      (by omega) (by omega) (by omega) (by norm_num)
      rfl (hχ3.trans h.symm)
  -- χ(4) ≠ 2: triple (6, 4, 6). 6 + 12 = 18 = 3·6.
  have h_chi_4_ne_2 : χ 4 ≠ 2 := fun h =>
    mono_3 6 4 6 (by norm_num) (by norm_num) (by norm_num)
      (by omega) (by omega) (by omega) (by norm_num)
      (hχ6.trans h.symm) (h.trans hχ6.symm)
  have h_v4 : χ 4 < 3 := hValid 4 (by norm_num) (by omega)
  have h_chi_4 : χ 4 = 1 := by omega
  -- Step 2: χ(7) = 2.
  -- χ(7) ≠ 0: distance pair (7, 12) dist 5 mult 15.
  have h_chi_7_ne_0 : χ 7 ≠ 0 := fun h =>
    color_avoids_distance_of_multiple (by omega : 2 ≤ 3) χ hAvoid
      (by omega : (0:ℕ) < 5) (by omega : (3:ℕ) * 5 ≤ n)
      7 (by norm_num) (by omega)
      (by show χ (3 * 5) = χ 7; rw [show (3:ℕ)*5 = 15 from by norm_num, hχ15, h])
      (by show χ 7 = χ (7 + 5); rw [show (7:ℕ)+5 = 12 from by norm_num, h, hχ12])
  -- χ(7) ≠ 1: triple (9, 4, 7). 9 + 12 = 21 = 3·7.
  have h_chi_7_ne_1 : χ 7 ≠ 1 := fun h =>
    mono_3 9 4 7 (by norm_num) (by norm_num) (by norm_num)
      (by omega) (by omega) (by omega) (by norm_num)
      (hχ9.trans h_chi_4.symm) (h_chi_4.trans h.symm)
  have h_v7 : χ 7 < 3 := hValid 7 (by norm_num) (by omega)
  have h_chi_7 : χ 7 = 2 := by omega
  -- Step 3: χ(5) = 1.
  -- χ(5) ≠ 0: distance pair (5, 12) dist 7 mult 21.
  have h_chi_5_ne_0 : χ 5 ≠ 0 := fun h =>
    color_avoids_distance_of_multiple (by omega : 2 ≤ 3) χ hAvoid
      (by omega : (0:ℕ) < 7) (by omega : (3:ℕ) * 7 ≤ n)
      5 (by norm_num) (by omega)
      (by show χ (3 * 7) = χ 5; rw [show (3:ℕ)*7 = 21 from by norm_num, hχ21, h])
      (by show χ 5 = χ (5 + 7); rw [show (5:ℕ)+7 = 12 from by norm_num, h, hχ12])
  -- χ(5) ≠ 2: distance pair (5, 7) dist 2 mult 6.
  have h_chi_5_ne_2 : χ 5 ≠ 2 := fun h =>
    color_avoids_distance_of_multiple (by omega : 2 ≤ 3) χ hAvoid
      (by omega : (0:ℕ) < 2) (by omega : (3:ℕ) * 2 ≤ n)
      5 (by norm_num) (by omega)
      (by show χ (3 * 2) = χ 5; rw [show (3:ℕ)*2 = 6 from by norm_num, hχ6, h])
      (by show χ 5 = χ (5 + 2); rw [show (5:ℕ)+2 = 7 from by norm_num, h, h_chi_7])
  have h_v5 : χ 5 < 3 := hValid 5 (by norm_num) (by omega)
  have h_chi_5 : χ 5 = 1 := by omega
  -- Step 4: χ(8) has no valid color.
  -- χ(8) ≠ 0: distance pair (3, 8) dist 5 mult 15.
  have h_chi_8_ne_0 : χ 8 ≠ 0 := fun h =>
    color_avoids_distance_of_multiple (by omega : 2 ≤ 3) χ hAvoid
      (by omega : (0:ℕ) < 5) (by omega : (3:ℕ) * 5 ≤ n)
      3 (by norm_num) (by omega)
      (by show χ (3 * 5) = χ 3; rw [show (3:ℕ)*5 = 15 from by norm_num, hχ15, hχ3])
      (by show χ 3 = χ (3 + 5); rw [show (3:ℕ)+5 = 8 from by norm_num, hχ3, h])
  -- χ(8) ≠ 1: triple (9, 5, 8). 9 + 15 = 24 = 3·8.
  have h_chi_8_ne_1 : χ 8 ≠ 1 := fun h =>
    mono_3 9 5 8 (by norm_num) (by norm_num) (by norm_num)
      (by omega) (by omega) (by omega) (by norm_num)
      (hχ9.trans h_chi_5.symm) (h_chi_5.trans h.symm)
  -- χ(8) ≠ 2: distance pair (6, 8) dist 2 mult 6.
  have h_chi_8_ne_2 : χ 8 ≠ 2 := fun h =>
    color_avoids_distance_of_multiple (by omega : 2 ≤ 3) χ hAvoid
      (by omega : (0:ℕ) < 2) (by omega : (3:ℕ) * 2 ≤ n)
      6 (by norm_num) (by omega)
      (by show χ (3 * 2) = χ 6; rw [show (3:ℕ)*2 = 6 from by norm_num])
      (by show χ 6 = χ (6 + 2); rw [show (6:ℕ)+2 = 8 from by norm_num, hχ6, h])
  have h_v8 : χ 8 < 3 := hValid 8 (by norm_num) (by omega)
  omega

/-! ### Round 75 (2026-05-15) — broader-class capstone: dispatcher
    theorem combining Rounds 60, 62, 67-73.

  Rounds 60, 62, 67-73 each handle a specific 3-element zero-set
  configuration in the 5+2+1 distribution.  Round 75 combines them
  into a single dispatcher: given that ANY of 9 specific triples
  is fully zero, derive False.

  This consolidates the broader-class coverage of the 5+2+1
  distribution space into ONE theorem usable by any caller. -/

/--
  **Round 75 Theorem (broader-class dispatcher).**

  Given the standard CompressionHyp 3 3 hypotheses ($\chi(9),
  \chi(18)$ distinct nonzero), if ANY of the following 9 triples
  of multiples-of-3 are all colored 0, derive False:

  AP-1 path: {3,6,12}, {3,6,15}, {3,6,21}, {6,12,15}, {6,15,24}.
  AP-2 path: {3,12,21}, {3,6,24}.
  AP-4 path: {3,12,15}.
  AP-5 path: {12,15,21}.

  Dispatches to the corresponding broader-class theorem.
-/
theorem compression_3_3_broader_dispatch {n : ℕ} (hn : 26 ≤ n)
    (χ : ℕ → ℕ) (hValid : IsValidColoring n 3 χ)
    (hAvoid : AvoidsMonoSolution 3 n χ)
    (hχ9_ne : χ 9 ≠ 0) (hχ18_ne : χ 18 ≠ 0)
    (hχ9_18_ne : χ 9 ≠ χ 18)
    (h_disj : (χ 3 = 0 ∧ χ 6 = 0 ∧ χ 12 = 0) ∨
              (χ 3 = 0 ∧ χ 6 = 0 ∧ χ 15 = 0) ∨
              (χ 3 = 0 ∧ χ 6 = 0 ∧ χ 21 = 0) ∨
              (χ 6 = 0 ∧ χ 12 = 0 ∧ χ 15 = 0) ∨
              (χ 6 = 0 ∧ χ 15 = 0 ∧ χ 24 = 0) ∨
              (χ 3 = 0 ∧ χ 12 = 0 ∧ χ 21 = 0) ∨
              (χ 3 = 0 ∧ χ 6 = 0 ∧ χ 24 = 0) ∨
              (χ 3 = 0 ∧ χ 12 = 0 ∧ χ 15 = 0) ∨
              (χ 12 = 0 ∧ χ 15 = 0 ∧ χ 21 = 0)) :
    False := by
  rcases h_disj with ⟨h3, h6, h12⟩ | ⟨h3, h6, h15⟩ | ⟨h3, h6, h21⟩ |
    ⟨h6, h12, h15⟩ | ⟨h6, h15, h24⟩ | ⟨h3, h12, h21⟩ |
    ⟨h3, h6, h24⟩ | ⟨h3, h12, h15⟩ | ⟨h12, h15, h21⟩
  · exact compression_3_3_with_3_6_12_color_0_infeasible hn χ hValid hAvoid
      h3 h6 h12 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_3_6_15_color_0_infeasible hn χ hValid hAvoid
      h3 h6 h15 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_3_6_21_color_0_infeasible hn χ hValid hAvoid
      h3 h6 h21 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_6_12_15_color_0_infeasible hn χ hValid hAvoid
      h6 h12 h15 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_6_15_24_color_0_infeasible hn χ hValid hAvoid
      h6 h15 h24 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_3_12_21_color_0_infeasible hn χ hValid hAvoid
      h3 h12 h21 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_3_6_24_color_0_infeasible hn χ hValid hAvoid
      h3 h6 h24 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_3_12_15_color_0_infeasible hn χ hValid hAvoid
      h3 h12 h15 hχ9_ne hχ18_ne hχ9_18_ne
  · exact compression_3_3_with_12_15_21_color_0_infeasible hn χ hValid hAvoid
      h12 h15 h21 hχ9_ne hχ18_ne hχ9_18_ne

/-! ### Round 76 (2026-05-15) — third corner case: $A_0 = \{1, 2,
    5, 7, 8\}$, $A_1 = \{3, 6\}$ ($\chi(9) = \chi(18) = 1$),
    $A_2 = \{4\}$ ($\chi(12) = 2$).

  Different attack than Rounds 66, 74 (which used singleton-2 with
  small distance 1, 2).  Here distance 4 is the color-2 forbidden
  distance.  Uses richer chain involving multiple self-loops at
  positions 12, 16, 24.

  Chain: χ(16) = 1 (self-loops (24, 16, 24) and (12, 12, 16));
