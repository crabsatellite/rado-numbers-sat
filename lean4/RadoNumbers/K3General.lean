theorem compression_3_3_with_3_6_15_color_0_infeasible {n : ℕ} (hn : 26 ≤ n)
    (χ : ℕ → ℕ) (hValid : IsValidColoring n 3 χ)
    (hAvoid : AvoidsMonoSolution 3 n χ)
    (hχ3 : χ 3 = 0) (hχ6 : χ 6 = 0) (hχ15 : χ 15 = 0)
    (hχ9_ne : χ 9 ≠ 0) (hχ18_ne : χ 18 ≠ 0)
    (hχ9_18_ne : χ 9 ≠ χ 18) :
    False := by
  have c0_avoid : ∀ (d : ℕ), 1 ≤ d → 3 * d ≤ n → χ (3 * d) = 0 →
      ∀ (y : ℕ), 1 ≤ y → y + d ≤ n → χ y = 0 → χ (y + d) = 0 → False :=
    fun d hd_pos h3d_le hχ3d y hy_pos hyd_le hχy hχyd =>
