      · -- n2 > n1: so order is n2 ≥ n1 ≥ n0: relabel (c2, c1, c0)
        have hO3' : n1 ≤ n2 := Nat.le_of_lt (Nat.lt_of_not_le hO3)
        have hSum' : n2 + n1 + n0 = 9 := by omega
        have hCls := layer3_count_vector_ordered_classify n2 n1 n0 hSum' hO3' hO1' hPos0
