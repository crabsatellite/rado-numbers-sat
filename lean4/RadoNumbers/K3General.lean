  have h_v13 : χ 13 < 3 := hValid 13 (by norm_num) (by omega)
  have h_v9 : χ 9 < 3 := hValid 9 (by norm_num) (by omega)
  have h_v18 : χ 18 < 3 := hValid 18 (by norm_num) (by omega)
  have h_a0 : χ 1 = χ 9 ∨ χ 1 = χ 18 := by omega
  have h_a1 : χ 4 = χ 9 ∨ χ 4 = χ 18 := by omega
  have h_a2 : χ 7 = χ 9 ∨ χ 7 = χ 18 := by omega
  have h_a3 : χ 10 = χ 9 ∨ χ 10 = χ 18 := by omega
  have h_a4 : χ 13 = χ 9 ∨ χ 13 = χ 18 := by omega
  exact AP5_avoidance_contradiction χ hAvoid (a := 1) (c1 := χ 9) (c2 := χ 18)
    (by norm_num) (by omega) (by omega) h_a0 h_a1 h_a2 h_a3 h_a4 rfl rfl

