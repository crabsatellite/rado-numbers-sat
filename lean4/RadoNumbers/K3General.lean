/-- **R436 Target B helper**: For any list of nats and function `f`,
    if 3 distinct values $c_0, c_1, c_2$ cover all `f`-images of list
    elements, then the lengths of the three filters sum to the list
    length.

    Proved by induction on the list, splitting on which of
    $c_0, c_1, c_2$ matches `f head`. -/
private lemma list_filter_three_colors_length_sum
    (L : List ℕ) (f : ℕ → ℕ)
    {c0 c1 c2 : ℕ}
    (h01 : c0 ≠ c1) (h02 : c0 ≠ c2) (h12 : c1 ≠ c2)
    (hCover : ∀ m, m ∈ L → f m = c0 ∨ f m = c1 ∨ f m = c2) :
    (L.filter (fun m => decide (f m = c0))).length +
    (L.filter (fun m => decide (f m = c1))).length +
    (L.filter (fun m => decide (f m = c2))).length = L.length := by
  induction L with
  | nil => simp
  | cons head tail ih =>
    have hHead := hCover head List.mem_cons_self
    have hTail : ∀ m, m ∈ tail → f m = c0 ∨ f m = c1 ∨ f m = c2 :=
      fun m hm => hCover m (List.mem_cons_of_mem _ hm)
    have ihTail := ih hTail
    rcases hHead with h | h | h
    · -- f head = c0
      have hP0 : (decide (f head = c0) : Bool) = true := decide_eq_true h
      have hP1 : (decide (f head = c1) : Bool) = false :=
        decide_eq_false (fun e => h01 (h.symm.trans e))
      have hP2 : (decide (f head = c2) : Bool) = false :=
        decide_eq_false (fun e => h02 (h.symm.trans e))
      simp only [List.filter_cons, hP0, hP1, hP2,
                 Bool.false_eq_true,
                 ↓reduceIte,
                 List.length_cons]
      omega
    · -- f head = c1
      have hP0 : (decide (f head = c0) : Bool) = false :=
        decide_eq_false (fun e => h01 (e.symm.trans h))
      have hP1 : (decide (f head = c1) : Bool) = true := decide_eq_true h
      have hP2 : (decide (f head = c2) : Bool) = false :=
        decide_eq_false (fun e => h12 (h.symm.trans e))
      simp only [List.filter_cons, hP0, hP1, hP2,
                 Bool.false_eq_true,
                 ↓reduceIte,
                 List.length_cons]
      omega
    · -- f head = c2
      have hP0 : (decide (f head = c0) : Bool) = false :=
        decide_eq_false (fun e => h02 (e.symm.trans h))
      have hP1 : (decide (f head = c1) : Bool) = false :=
        decide_eq_false (fun e => h12 (e.symm.trans h))
      have hP2 : (decide (f head = c2) : Bool) = true := decide_eq_true h
      simp only [List.filter_cons, hP0, hP1, hP2,
                 Bool.false_eq_true,
                 ↓reduceIte,
                 List.length_cons]
      omega

/-- **R436 Target B**: Sum of layer3 layer counts over any 3 distinct
    colors all $< 3$ equals 9.

    The three colors must be the three values $\{0, 1, 2\}$ in some
    order, and every layer3 position has $\chi < 3$ by validity.  So
    every layer3 position contributes to exactly one of the three
    filters, and the lengths sum to `layer3.length = 9`. -/
theorem layer3_count_sum_of_three_colors
    (χ : ℕ → ℕ) (hValid : IsValidColoring 27 3 χ)
    {c0 c1 c2 : ℕ}
    (h01 : c0 ≠ c1) (h02 : c0 ≠ c2) (h12 : c1 ≠ c2)
    (h0_lt : c0 < 3) (h1_lt : c1 < 3) (h2_lt : c2 < 3) :
    layerCount χ c0 + layerCount χ c1 + layerCount χ c2 = 9 := by
  unfold layerCount
  have hCover : ∀ m, m ∈ layer3 → χ m = c0 ∨ χ m = c1 ∨ χ m = c2 := by
    intro m hmL
    have hχm : χ m < 3 := layer3_chi_lt_3 χ hValid hmL
    by_contra hne
    have hne0 : χ m ≠ c0 := fun h => hne (Or.inl h)
    have hne1 : χ m ≠ c1 := fun h => hne (Or.inr (Or.inl h))
    have hne2 : χ m ≠ c2 := fun h => hne (Or.inr (Or.inr h))
    omega
  have hLen : layer3.length = 9 := layer3_length
  have := list_filter_three_colors_length_sum layer3 χ h01 h02 h12 hCover
  -- The filters use `decide (χ m = ci)`; these are definitionally equal to the
  -- `χ m = ci` form used by `layerCount`.
  omega

/-- **R436 Target A**: Count-vector classifier (ordered version).

    For positive triples $(a, b, c)$ with $a + b + c = 9$ and $c \le b
    \le a$, the triple is one of the 7 canonical layer-3 partition
    shapes.

    Pure `omega`. -/
lemma layer3_count_vector_ordered_classify
    (a b c : ℕ) (hSum : a + b + c = 9)
    (hOrd1 : b ≤ a) (hOrd2 : c ≤ b)
    (hPos : 1 ≤ c) :
    (a = 7 ∧ b = 1 ∧ c = 1) ∨
    (a = 6 ∧ b = 2 ∧ c = 1) ∨
    (a = 5 ∧ b = 3 ∧ c = 1) ∨
    (a = 5 ∧ b = 2 ∧ c = 2) ∨
    (a = 4 ∧ b = 4 ∧ c = 1) ∨
    (a = 4 ∧ b = 3 ∧ c = 2) ∨
    (a = 3 ∧ b = 3 ∧ c = 3) := by
  omega

/-! ### Target C — Unified layer3 partition closure.

  The unified theorem `compression_3_3_layer3_infeasible` takes any
  three distinct colors $c_0, c_1, c_2 \in \{0, 1, 2\}$ with all three
  layer-3 counts positive, classifies the count-vector by sorting it
  into one of the 7 canonical shapes, and dispatches to the
  appropriate R424-R435 master with permuted color labels.

  The dispatch involves $3! = 6$ orderings × 7 shapes = up to 42
  leaves, but many collapse (e.g., 3+3+3 needs only 1; 4+4+1 needs 3;
  5+2+2 needs 3; the rest with all distinct sizes need 6 each).

  To keep the proof compact, we sort the count tuple via a 6-way
  $S_3$ case split, then dispatch each ordered case to a single
  shape-master invocation with relabeled $(c_0, c_1, c_2)$.

  Permutation note: each shape master expects $c_0$ to be the LARGEST
  class, $c_1$ middle, $c_2$ smallest.  For shapes with equal sizes
  (4+4+1, 5+2+2, 3+3+3), the corresponding labels are
  interchangeable. -/

set_option maxHeartbeats 2000000 in
/-- **R436 Target C — UNIFIED LAYER3 COMPRESSION THEOREM**.

    For any mono-free valid 3-coloring of $\{1, \ldots, 27\}$ and any
    3 pairwise-distinct colors $c_0, c_1, c_2$ all $< 3$ with every
    layer-3 count positive, contradiction.

    This is the kernel-pure unified closure of all 7 layer-3
    partition shapes (R424-R435).  Together with
    `bAdicEquation_3_no_mono_free_at_27` (BasicResults.lean §86,
    R245 Branch I-V/I-W route), it provides an independent
    kernel-pure derivation of $R_3(3) \le 27$ on the layer-3 path.

    **No SAT axioms.**  **No `decide`/`native_decide` on coloring
    data.**  Pure kernel via the 7 shape master infrastructure. -/
theorem compression_3_3_layer3_infeasible
    (χ : ℕ → ℕ)
    (hValid : IsValidColoring 27 3 χ)
    (hAvoid : AvoidsMonoSolution 3 27 χ)
    {c0 c1 c2 : ℕ}
    (h01 : c0 ≠ c1) (h02 : c0 ≠ c2) (h12 : c1 ≠ c2)
    (hPos0 : 0 < layerCount χ c0)
    (hPos1 : 0 < layerCount χ c1)
    (hPos2 : 0 < layerCount χ c2) :
    False := by
  -- Color values < 3 via layer3 positivity + validity.
  have c0_lt : c0 < 3 := layer3_color_lt_3_of_card_pos χ hValid hPos0
  have c1_lt : c1 < 3 := layer3_color_lt_3_of_card_pos χ hValid hPos1
  have c2_lt : c2 < 3 := layer3_color_lt_3_of_card_pos χ hValid hPos2
  -- Sum of counts = 9 by Target B.
  have hSum := layer3_count_sum_of_three_colors χ hValid h01 h02 h12 c0_lt c1_lt c2_lt
  -- Set abbreviations.
  set n0 := layerCount χ c0 with hn0_def
  set n1 := layerCount χ c1 with hn1_def
  set n2 := layerCount χ c2 with hn2_def
  -- Now (n0, n1, n2) is a 3-positive partition of 9.  Sort via S_3 case split.
  -- Six orderings; for each, the multiset {n0, n1, n2} = (a, b, c) with a ≥ b ≥ c,
  -- a + b + c = 9, c ≥ 1 ⇒ one of 7 shapes.  We dispatch per ordering separately.
  --
  -- Dispatcher: 6 orderings × shape classifier × shape master invocations.
  -- The key economy: each ordering picks (largest, middle, smallest) = (cA, cB, cC),
  -- then dispatches by the 7-shape disjunction.
  --
  -- Each ordering case ends in a single master invocation with relabeled colors.
  by_cases hO1 : n1 ≤ n0
  · by_cases hO2 : n2 ≤ n1
    · -- n0 ≥ n1 ≥ n2: dispatch with (c0, c1, c2) as (max, mid, min).
      have hCls := layer3_count_vector_ordered_classify n0 n1 n2 hSum hO1 hO2 hPos2
      rcases hCls with ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
                       | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
      · -- 7+1+1
        exact compression_3_3_7_1_1_card7_infeasible χ hAvoid (c := c0)
          (by show (layer3.filter (fun m => χ m = c0)).length = 7
              exact e0)
      · -- 6+2+1
        exact compression_3_3_6_2_1_card6_infeasible χ hValid hAvoid (c := c0)
          (by show (layer3.filter (fun m => χ m = c0)).length = 6
              exact e0)
      · -- 5+3+1
        exact compression_3_3_5_3_1_card_distribution_infeasible χ hValid hAvoid
          h01 h02 h12 e0 e1 e2
      · -- 5+2+2
        exact compression_3_3_5_2_2_card_distribution_infeasible χ hValid hAvoid
          h01 h02 h12 e0 e1 e2
      · -- 4+4+1
        exact compression_3_3_4_4_1_card_distribution_infeasible χ hValid hAvoid
          h01 h02 h12 e0 e1 e2
      · -- 4+3+2
        exact compression_3_3_4_3_2_card_distribution_infeasible χ hValid hAvoid
          h01 h02 h12 e0 e1 e2
      · -- 3+3+3
        exact compression_3_3_3_3_3_card_distribution_infeasible χ hValid hAvoid
          h01 h02 h12 e0 e1 e2
    · -- n1 < n2 ≤ ? : test (n0 vs n2)
      have hO2' : n1 ≤ n2 := Nat.le_of_lt (Nat.lt_of_not_le hO2)
      by_cases hO3 : n2 ≤ n0
      · -- n0 ≥ n2 ≥ n1: relabel (cA, cB, cC) = (c0, c2, c1).
        have hSum' : n0 + n2 + n1 = 9 := by omega
        have hCls := layer3_count_vector_ordered_classify n0 n2 n1 hSum' hO3 hO2' hPos1
        rcases hCls with ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
                         | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
        · -- 7+1+1: c0 has count 7
          exact compression_3_3_7_1_1_card7_infeasible χ hAvoid (c := c0)
            (by show (layer3.filter (fun m => χ m = c0)).length = 7
                exact e0)
        · -- 6+2+1: c0 has count 6
          exact compression_3_3_6_2_1_card6_infeasible χ hValid hAvoid (c := c0)
            (by show (layer3.filter (fun m => χ m = c0)).length = 6
                exact e0)
        · -- 5+3+1: relabel (c0, c2, c1)
          exact compression_3_3_5_3_1_card_distribution_infeasible χ hValid hAvoid
            (c0 := c0) (c1 := c2) (c2 := c1)
            h02 h01 (Ne.symm h12) e0 e1 e2
        · -- 5+2+2
          exact compression_3_3_5_2_2_card_distribution_infeasible χ hValid hAvoid
            (c0 := c0) (c1 := c2) (c2 := c1)
            h02 h01 (Ne.symm h12) e0 e1 e2
        · -- 4+4+1
          exact compression_3_3_4_4_1_card_distribution_infeasible χ hValid hAvoid
            (c0 := c0) (c1 := c2) (c2 := c1)
            h02 h01 (Ne.symm h12) e0 e1 e2
        · -- 4+3+2
          exact compression_3_3_4_3_2_card_distribution_infeasible χ hValid hAvoid
            (c0 := c0) (c1 := c2) (c2 := c1)
            h02 h01 (Ne.symm h12) e0 e1 e2
        · -- 3+3+3
          exact compression_3_3_3_3_3_card_distribution_infeasible χ hValid hAvoid
            (c0 := c0) (c1 := c2) (c2 := c1)
            h02 h01 (Ne.symm h12) e0 e1 e2
      · -- n2 > n0: so order is n2 ≥ n0 ≥ n1 (or n2 ≥ n1 but n0 < n2, n1 ≤ n0).
        -- We have n1 ≤ n0 (hO1), n1 < n2 (from hO2'), and n0 < n2 (from hO3 negated).
        -- So n2 ≥ n0 ≥ n1: relabel (cA, cB, cC) = (c2, c0, c1).
